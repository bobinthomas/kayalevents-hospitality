# Supabase (see README for provisioning steps)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EDGE_FUNCTIONS_URL=

# Turnstile — reuse the existing kayalevents.com.au widget if it can add this
# hostname; otherwise create a new one. Server secret is also set as a
# Supabase Edge Function secret (`supabase secrets set TURNSTILE_SECRET=...`),
# not just here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Submission PDF pre-warm — the submit-form Edge Function calls
# /api/internal/generate-submission-pdf right after an artist submits, so
# the PDF is already in storage by the time an admin clicks Export. Shared
# secret must match on both sides: set as a Cloudflare Worker secret here
# AND as a Supabase Edge Function secret (`supabase secrets set
# INTERNAL_API_SECRET=...`). HOSPITALITY_APP_URL is Edge-Function-side only
# (points the function at this app) — set via `supabase secrets set`, not here.
INTERNAL_API_SECRET=
